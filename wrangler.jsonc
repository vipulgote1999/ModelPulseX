{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modelpulsex",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/frontend",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modelpulsex-db",
      "database_id": "c588d2cd-1fdc-44fb-879f-f0995c18f7ea",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "BENCH_QUEUE", "queue": "bench-queue" }],
    "consumers": [{ "queue": "bench-queue", "max_concurrency": 8, "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 3, "dead_letter_queue": "bench-dlq" }]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE_DO", "class_name": "PerformanceDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PerformanceDO"] }],
  "triggers": {
    "crons": ["*/5 * * * *", "*/10 * * * *", "*/30 * * * *", "0 * * * *"]
  },
  "observability": { "enabled": true },
  "vars": {
    "MAX_GLOBAL_CONCURRENCY": "40",
    "MAX_OPENCODE_CONCURRENCY": "3",
    "MAX_OPENROUTER_CONCURRENCY": "4",
    "MAX_GROQ_CONCURRENCY": "3",
    "MAX_CEREBRAS_CONCURRENCY": "2",
    "MAX_GEMINI_CONCURRENCY": "3",
    "MAX_NVIDIA_CONCURRENCY": "2",
    "MAX_SAMBANOVA_CONCURRENCY": "1",
    "MAX_MISTRAL_CONCURRENCY": "2",
    "MAX_AGNES_AI_CONCURRENCY": "2",
    "MAX_AIONLABS_CONCURRENCY": "2",
    "MAX_KILOCODE_CONCURRENCY": "2",
    "MAX_GLHF_CONCURRENCY": "2",
    "MAX_NSCALE_CONCURRENCY": "2",
    "MAX_SPEKA_CONCURRENCY": "2",
    "MAX_NEXAAPI_CONCURRENCY": "2",
    "MAX_ORCAROUTER_CONCURRENCY": "2",
    "MAX_NINEROUTER_CONCURRENCY": "2",
    "MAX_TOKENROUTER_CONCURRENCY": "3",
    "MAX_OLLAMA_CONCURRENCY": "2",
    "MAX_SAME_MODEL_CONCURRENCY": "1",
    "BENCHMARK_TIMEOUT_MS": "30000",
    "INCIDENT_THRESHOLD": "3",
    "STALE_ALERT_MINUTES": "30"
  }
  // secrets (never in file):
  // wrangler secret put ADMIN_TOKEN
  // wrangler secret put ALERT_WEBHOOK_URL   (optional — Discord/Slack-compatible stale alerts)
  // BENCH_INLINE_FALLBACK (default 6) and COOLDOWN_MAX_MS (default 2h) have code defaults; see src/types.ts Env.
  // wrangler secret put OPENCODE_API_KEY
  // wrangler secret put OPENROUTER_API_KEY
  // wrangler secret put GROQ_API_KEY
  // wrangler secret put CEREBRAS_API_KEY
  // wrangler secret put GEMINI_API_KEY
  // wrangler secret put NVIDIA_API_KEY
  // wrangler secret put SAMBANOVA_API_KEY
  // wrangler secret put MISTRAL_API_KEY
  // wrangler secret put AGNES_API_KEY
  // wrangler secret put AIONLABS_API_KEY
  // wrangler secret put KILOCODE_API_KEY
  // wrangler secret put GLHF_API_KEY
  // wrangler secret put NSCALE_API_KEY
  // wrangler secret put SPEKA_API_KEY
  // wrangler secret put NEXAAPI_API_KEY
  // wrangler secret put ORCAROUTER_API_KEY
  // wrangler secret put NINEROUTER_API_KEY
  // wrangler secret put TOKENROUTER_API_KEY
  // wrangler secret put OLLAMA_API_KEY
  // wrangler secret put ADMIN_TOKEN
}
