{
  "name": "modelpulsex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ModelPulseX — Cloudflare-native LLM Performance Observatory for FREE OpenCode Zen + OpenRouter models",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:remote": "wrangler dev",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "migrate": "wrangler d1 migrations apply DB",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy",
    "cf:typegen": "wrangler types",
    "secret-scan": "node scripts/secret-scan.js",
    "security:audit": "npm audit && node scripts/secret-scan.js"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.6",
    "wrangler": "^4.24.0"
  }
}
