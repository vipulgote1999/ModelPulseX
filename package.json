{
  "name": "modelpulsex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ModelPulseX — Cloudflare-native LLM Performance Observatory for FREE OpenCode Zen + OpenRouter models",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:remote": "wrangler dev",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx 2>&1 || echo \"lint: no config, typecheck is gate\"",
    "migrate": "wrangler d1 migrations apply DB",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.8",
    "wrangler": "^4.24.0"
  }
}
